<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Projeto_Faculdade.Views.ModuloPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F5FF">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Border
            Grid.Row="0"
            BackgroundColor="#F0EDFF"
            Stroke="#DDD6FE"
            StrokeThickness="1"
            Padding="15,10">

            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Text="‹"
                    FontSize="32"
                    TextColor="#6D28D9"
                    BackgroundColor="Transparent"
                    WidthRequest="50"
                    HeightRequest="45"
                    Clicked="VoltarClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="1">

                    <Label
                        x:Name="NumeroModuloLabel"
                        Text="Módulo 1"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#8B5CF6" />

                    <Label
                        x:Name="TituloModuloLabel"
                        Text="Respeito"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#222052" />

                </VerticalStackLayout>

            </Grid>

        </Border>


        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="25,25,25,35"
                Spacing="20">

                <!-- TÍTULO -->
                <VerticalStackLayout
                    Spacing="6">

                    <Label
                        Text="Vamos aprender"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#8B5CF6"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="TituloPrincipalLabel"
                        Text="Respeito"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#222052"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- TEXTO EDUCATIVO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#8B5CF6"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 24"
                    Padding="22">

                    <VerticalStackLayout
                        Spacing="14">

                        <Label
                            Text="CONTEÚDO"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#8B5CF6" />

                        <Label
                            x:Name="TextoModuloLabel"
                            Text="Conteúdo do módulo..."
                            FontSize="17"
                            TextColor="#222052"
                            LineBreakMode="WordWrap"
                            LineHeight="1.3" />

                    </VerticalStackLayout>

                </Border>


                <!-- MENSAGEM -->
                <Border
                    BackgroundColor="#F0EDFF"
                    Stroke="#DDD6FE"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Text="Antes de continuar"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#6D28D9" />

                        <Label
                            Text="Leia o conteúdo com atenção. Depois, você poderá responder às perguntas sobre o que aprendeu."
                            FontSize="15"
                            TextColor="#5146E5"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>


                <!-- BOTÃO -->
                <Button
                    Text="Continuar para as perguntas"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#129E91"
                    CornerRadius="17"
                    HeightRequest="58"
                    Margin="0,5,0,0"
                    Clicked="ContinuarPerguntasClicked" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>