<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Projeto_Faculdade.Views.CadastroPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F5FF">

    <Grid RowDefinitions="Auto,*">

        <!-- BARRA SUPERIOR -->
        <Border
            Grid.Row="0"
            BackgroundColor="#F0EDFF"
            Stroke="#DDD6FE"
            StrokeThickness="1"
            Padding="20,12">

            <HorizontalStackLayout Spacing="12">

                <Border
                    WidthRequest="42"
                    HeightRequest="42"
                    BackgroundColor="#8B5CF6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10">

                    <Label
                        Text="◉"
                        FontSize="20"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

                <Label
                    Text="Cadastro"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#222052"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

        </Border>


        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Spacing="15"
                Padding="25,28,25,35"
                HorizontalOptions="Center">


                <!-- TÍTULO -->
                <Label
                    Text="Crie sua conta!"
                    FontSize="32"
                    FontAttributes="Bold"
                    TextColor="#222052"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Vamos começar essa aventura juntos!"
                    FontSize="17"
                    TextColor="#5146E5"
                    HorizontalTextAlignment="Center"
                    Margin="0,-5,0,8" />


                <!-- CARD DO BETO -->
                <Border
                    WidthRequest="430"
                    BackgroundColor="White"
                    Stroke="#DDD6FE"
                    StrokeThickness="3"
                    StrokeShape="RoundRectangle 28"
                    Padding="18"
                    HorizontalOptions="Center">

                    <HorizontalStackLayout
                        Spacing="15"
                        HorizontalOptions="Center">

                        <!-- IMAGEM DO BETO -->
                        <Border
                            WidthRequest="100"
                            HeightRequest="100"
                            BackgroundColor="#FFF4C7"
                            Stroke="#D97706"
                            StrokeThickness="4"
                            StrokeShape="RoundRectangle 50"
                            VerticalOptions="Center">

                            <Image
                                Source="logo.png"
                                WidthRequest="80"
                                HeightRequest="80"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <VerticalStackLayout
                            Spacing="5"
                            VerticalOptions="Center"
                            MaximumWidthRequest="250">

                            <Label
                                Text="Olá! Eu sou o Beto!"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#222052" />

                            <Label
                                Text="Crie seu perfil e venha aprender sobre respeito, empatia e boa convivência!"
                                FontSize="14"
                                TextColor="#5146E5" />

                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                </Border>


                <!-- NOME -->
                <VerticalStackLayout
                    WidthRequest="500"
                    Spacing="7"
                    Margin="0,5,0,0">

                    <Label
                        Text="Qual seu nome?"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#222052" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#8B5CF6"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,0">

                        <Entry
                            x:Name="NomeEntry"
                            Placeholder="Digite seu nome..."
                            FontSize="17"
                            TextColor="#222052"
                            PlaceholderColor="#A1A1AA"
                            HeightRequest="55" />

                    </Border>

                </VerticalStackLayout>


                <!-- SENHA -->
                <VerticalStackLayout
                    WidthRequest="500"
                    Spacing="7">

                    <Label
                        Text="Crie uma senha"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#222052" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#8B5CF6"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,0">

                        <Entry
                            x:Name="SenhaEntry"
                            Placeholder="Digite sua senha..."
                            FontSize="17"
                            TextColor="#222052"
                            PlaceholderColor="#A1A1AA"
                            IsPassword="True"
                            HeightRequest="55" />

                    </Border>

                </VerticalStackLayout>


                
                <VerticalStackLayout
                    WidthRequest="500"
                    Spacing="7">

                    <Label
                        Text="Confirme sua senha"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#222052" />

                    <Border
                        BackgroundColor="White"
                        Stroke="#8B5CF6"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,0">

                        <Entry
                            x:Name="ConfirmarSenhaEntry"
                            Placeholder="Digite sua senha novamente..."
                            FontSize="17"
                            TextColor="#222052"
                            PlaceholderColor="#A1A1AA"
                            IsPassword="True"
                            HeightRequest="55" />

                    </Border>

                </VerticalStackLayout>


                
                <Button
                    x:Name="CadastrarButton"
                    WidthRequest="500"
                    Text="Criar minha conta 🚀"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#129E91"
                    CornerRadius="16"
                    HeightRequest="60"
                    Margin="0,5,0,0"
                    Clicked="CadastrarButton_Clicked" />


              
                <Label
                    Text="Já possui uma conta?"
                    FontSize="14"
                    TextColor="#71717A"
                    HorizontalTextAlignment="Center"
                    Margin="0,2,0,0" />

                <Button
                    Text="Voltar para o login"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#6D28D9"
                    BackgroundColor="Transparent"
                    HeightRequest="40"
                    Clicked="VoltarLogin_Clicked" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>