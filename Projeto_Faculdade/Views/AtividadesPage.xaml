<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Projeto_Faculdade.Views.AtividadesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F5FF">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Border
            Grid.Row="0"
            BackgroundColor="#F0EDFF"
            Stroke="#DDD6FE"
            StrokeThickness="1"
            Padding="15,10">

            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Text="‹"
                    FontSize="32"
                    TextColor="#6D28D9"
                    BackgroundColor="Transparent"
                    WidthRequest="50"
                    HeightRequest="45"
                    Clicked="VoltarClicked" />

                <Label
                    Grid.Column="1"
                    Text="Atividades - ConvivêNET"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="#222052"
                    VerticalOptions="Center" />

            </Grid>

        </Border>


        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="25,25,25,35"
                Spacing="18">

                <!-- TÍTULO -->

                <Label
                    Text="Sua jornada"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#222052"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Aprenda sobre respeito e convivência através de diferentes módulos."
                    FontSize="16"
                    TextColor="#5146E5"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />


                <!-- PROGRESSO -->

                <Border
                    BackgroundColor="White"
                    Stroke="#8B5CF6"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 20"
                    Padding="18">

                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Seu progresso"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#222052" />

                            <Label
                                x:Name="ProgressoLabel"
                                Grid.Column="1"
                                Text="0 / 4 módulos"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#6D28D9" />

                        </Grid>

                        <ProgressBar
                            x:Name="ProgressoBar"
                            Progress="0"
                            ProgressColor="#8B5CF6"
                            BackgroundColor="#EDE9FE"
                            HeightRequest="10" />

                    </VerticalStackLayout>

                </Border>


                <!-- MÓDULOS -->

                <Label
                    Text="Módulos"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#222052"
                    Margin="0,5,0,0" />

                <VerticalStackLayout
                    x:Name="ModulosLayout"
                    Spacing="15" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>