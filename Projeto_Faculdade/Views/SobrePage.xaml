<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Projeto_Faculdade.Views.SobrePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F5FF">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CABEÇALHO -->
        <Border
            Grid.Row="0"
            BackgroundColor="#F0EDFF"
            Stroke="#DDD6FE"
            StrokeThickness="1"
            Padding="20,14">

            <HorizontalStackLayout Spacing="12">

                <Border
                    WidthRequest="46"
                    HeightRequest="46"
                    BackgroundColor="#8B5CF6"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14">

                    <Image
                        Source="logo.png"
                        WidthRequest="36"
                        HeightRequest="36"
                        Aspect="AspectFit"
                        VerticalOptions="Center"
                        HorizontalOptions="Center" />
                </Border>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="Projeto"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#222052" />

                    <Label
                        Text="Créditos e informações"
                        FontSize="13"
                        TextColor="#6D28D9" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <!-- SOBRE -->
                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Sobre o projeto"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="Black" />

                    <Label
                        Text="Este aplicativo foi desenvolvido como parte das atividades da disciplina de Programação de Computadores, com o objetivo de trabalhar a convivência e o respeito nos ambientes escolar e social."
                        FontSize="15"
                        TextColor="#444444" />

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#DDDDDD" />

                <!-- INFORMAÇÕES ACADÊMICAS -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Informações acadêmicas"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="Black" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Disciplina" FontSize="13" TextColor="Gray" />
                        <Label Text="Programação de Computadores" FontSize="15" TextColor="#333333" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Professor responsável" FontSize="13" TextColor="Gray" />
                        <Label Text="Prof. Dr. Elvio Gilberto da Silva" FontSize="15" TextColor="#333333" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Curso" FontSize="13" TextColor="Gray" />
                        <Label Text="Ciência da Computação" FontSize="15" TextColor="#333333" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Instituição" FontSize="13" TextColor="Gray" />
                        <Label
                            Text="Centro Universitário Sagrado Coração - UNISAGRADO"
                            FontSize="15"
                            TextColor="#333333" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Período de desenvolvimento" FontSize="13" TextColor="Gray" />
                        <Label Text="2º semestre de 2026" FontSize="15" TextColor="#333333" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#DDDDDD" />

                <!-- DESENVOLVEDORES -->
                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Desenvolvedores"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="Black" />

                    <Label
                        Text="Equipe responsável pelo planejamento e desenvolvimento da aplicação:"
                        FontSize="14"
                        TextColor="#444444" />

                    <Label Text="• HAYTAN SABEH" FontSize="15" TextColor="#333333" />
                    <Label Text="• LAURA DOS ANJOS" FontSize="15" TextColor="#333333" />
                    <Label Text="• LETICIA CORREA" FontSize="15" TextColor="#333333" />
                    <Label Text="• NAYLA SOUZA" FontSize="15" TextColor="#333333" />

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#DDDDDD" />

                <!-- TECNOLOGIAS -->
                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Tecnologias utilizadas"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="Black" />

                    <Label
                        Text="Para o desenvolvimento da aplicação, foram utilizadas as seguintes tecnologias e ferramentas:"
                        FontSize="14"
                        TextColor="#444444" />

                    <Label Text="• C#" FontSize="15" TextColor="#333333" />
                    <Label Text="• .NET MAUI" FontSize="15" TextColor="#333333" />
                    <Label Text="• XAML" FontSize="15" TextColor="#333333" />
                    <Label Text="• SQLite" FontSize="15" TextColor="#333333" />
                    <Label Text="• Visual Studio" FontSize="15" TextColor="#333333" />

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#DDDDDD" />

                <!-- VERSÃO -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="Versão da aplicação"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="Black" />

                    <Label
                        Text="Versão 1.0.0"
                        FontSize="15"
                        TextColor="#333333" />

                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#DDDDDD" />


                <!-- LOGOTIPOS -->
                <VerticalStackLayout Spacing="12">

                    <Label
        Text="Identificação e apoio"
        FontSize="19"
        FontAttributes="Bold"
        TextColor="Black"
        HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <!-- COMPUTAÇÃO -->
                        <VerticalStackLayout
            Grid.Column="0"
            Spacing="8">

                            <Border
                Stroke="#DDDDDD"
                StrokeThickness="1"
                Padding="0"
                HeightRequest="210">

                                <Image
                    Source="computacao.jpg"
                    Aspect="AspectFit"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                            </Border>

                            <Label
                Text="Desenvolvimento"
                FontSize="13"
                TextColor="#333333"
                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <!-- EXTENSÃO -->
                        <VerticalStackLayout
            Grid.Column="1"
            Spacing="8">

                            <Border
                Stroke="#DDDDDD"
                StrokeThickness="1"
                Padding="0"
                HeightRequest="210">

                                <Image
                    Source="extensao.jpg"
                    Aspect="AspectFit"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                            </Border>

                            <Label
                Text="Apoio"
                FontSize="13"
                TextColor="#333333"
                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

                <Label
                    Text="Desenvolvido como parte da formação acadêmica em Ciência da Computação."
                    FontSize="13"
                    TextColor="Gray"
                    HorizontalTextAlignment="Center"
                    Margin="0,5,0,10" />

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- NAVEGAÇÃO INFERIOR -->
        <Border
            Grid.Row="2"
            BackgroundColor="White"
            Stroke="#DDD6FE"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 22"
            Margin="20,5,20,16"
            Padding="8">

            <Grid ColumnDefinitions="*,*,*">

                <Button
                    Grid.Column="0"
                    Text="Início"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#5146E5"
                    BackgroundColor="Transparent"
                    HeightRequest="48"
                    Clicked="OnInicioClicked" />

                <Button
                    Grid.Column="1"
                    Text="Atividades"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#5146E5"
                    BackgroundColor="Transparent"
                    HeightRequest="48"
                    Clicked="OnAtividadesClicked" />

                <Button
                    Grid.Column="2"
                    Text="Sobre"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#6D28D9"
                    BackgroundColor="#EDE9FE"
                    CornerRadius="16"
                    HeightRequest="48" />

            </Grid>
        </Border>

    </Grid>
</ContentPage>
