<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Projeto_Faculdade.Views.TextoModuloPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#F7F5FF">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Border
            Grid.Row="0"
            BackgroundColor="#F0EDFF"
            Stroke="#DDD6FE"
            StrokeThickness="1"
            Padding="15,10">

            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Text="‹"
                    FontSize="32"
                    TextColor="#6D28D9"
                    BackgroundColor="Transparent"
                    WidthRequest="50"
                    HeightRequest="45"
                    Clicked="VoltarClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="1">

                    <Label
                        Text="Conteúdo educativo"
                        FontSize="13"
                        TextColor="#6D28D9" />

                    <Label
                        x:Name="TituloModuloLabel"
                        Text="Módulo"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#222052" />

                </VerticalStackLayout>

            </Grid>

        </Border>


        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="25,28,25,35"
                Spacing="18">


                <!-- TÍTULO -->

                <VerticalStackLayout
                    Spacing="6"
                    HorizontalOptions="Center">

                    <Label
                        Text="Vamos aprender"
                        FontSize="29"
                        FontAttributes="Bold"
                        TextColor="#222052"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Leia com atenção antes de começar as perguntas."
                        FontSize="16"
                        TextColor="#5146E5"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>


                <!-- IDENTIFICAÇÃO DO MÓDULO -->

                <Border
                    BackgroundColor="#EDE9FE"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="14,9"
                    HorizontalOptions="Center">

                    <Label
                        Text="CONTEÚDO DO MÓDULO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#6D28D9"
                        HorizontalTextAlignment="Center" />

                </Border>


                <!-- TEXTO EDUCATIVO -->

                <Border
                    BackgroundColor="White"
                    Stroke="#8B5CF6"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 24"
                    Padding="22">

                    <VerticalStackLayout
                        Spacing="10">

                        <!-- TÍTULO DO ASSUNTO -->
                        <Label
                            x:Name="TituloTextoLabel"
                            Text="Respeito"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#222052" />

                        <!-- IMAGEM DO MÓDULO -->

                       
                        <Image
                            x:Name="ImagemModulo"
                            HeightRequest="260"
                            WidthRequest="600"
                            Aspect="AspectFit"
                            HorizontalOptions="Fill"
                            Margin="0,-5,0,0" />

                        <!-- LINHA DECORATIVA -->
                        <BoxView
                            HeightRequest="3"
                            WidthRequest="55"
                            BackgroundColor="#8B5CF6"
                            HorizontalOptions="Start" />

                        <!-- TEXTO -->
                        <Label
                            x:Name="TextoEducativoLabel"
                            Text="Texto educativo..."
                            FontSize="17"
                            TextColor="#33304F"
                            LineBreakMode="WordWrap"
                            LineHeight="1.5" />
                    </VerticalStackLayout>

                </Border>


                <!-- AVISO -->

                <Border
                    BackgroundColor="#F0EDFF"
                    Stroke="#DDD6FE"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">

                    <VerticalStackLayout
                        Spacing="5">

                        <Label
                            Text="Depois da leitura"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#6D28D9" />

                        <Label
                            Text="Quando terminar, avance para responder às perguntas deste módulo."
                            FontSize="14"
                            TextColor="#5146E5"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>


                <!-- BOTÃO CONTINUAR -->

                <Button
                    Text="Continuar para as perguntas"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#129E91"
                    CornerRadius="16"
                    HeightRequest="58"
                    Margin="0,3,0,0"
                    Clicked="ContinuarClicked" />


            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>